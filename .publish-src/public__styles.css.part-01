 }
.button:disabled { opacity: .5; cursor: not-allowed; transform: none; }
.button svg { width: 16px; height: 16px; }
.button-primary { background: var(--accent); color: #042f2e; }
.button-primary:hover { background: #5eead4; }
.button-secondary { background: var(--surface); border-color: var(--line); color: var(--text); }
.button-secondary:hover { background: var(--surface-hover); border-color: var(--line-strong); }
.button-ghost { background: transparent; border-color: var(--line); color: var(--text-secondary); }
.button-danger { background: transparent; border-color: var(--line); color: var(--danger); }
kbd { padding: 2px 5px; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--text-muted); font-size: 9px; }

.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}
.panel-header {
  min-height: 58px;
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--line);
}
.panel-title { margin: 0; font-size: 14px; letter-spacing: -.01em; }
.panel-subtitle { margin: 4px 0 0; color: var(--text-muted); font-size: 11px; line-height: 1.45; }
.panel-body { padding: 18px; }
.panel-actions { display: flex; align-items: center; gap: 8px; }

.hero-panel {
  min-height: 230px;
  padding: 28px;
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(360px, .75fr);
  gap: 34px;
  align-items: center;
  background:
    linear-gradient(115deg, rgba(45, 212, 191, .08), transparent 45%),
    var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.hero-copy h2 { max-width: 760px; margin: 0; font-size: clamp(28px, 3vw, 44px); line-height: 1.04; letter-spacing: -.045em; }
.hero-copy p { max-width: 700px; margin: 16px 0 0; color: var(--text-secondary); font-size: 14px; line-height: 1.65; }
.hero-actions { margin-top: 22px; display: flex; gap: 10px; flex-wrap: wrap; }
.hero-diagram { min-height: 178px; position: relative; display: grid; place-items: center; }
.hero-orbit { position: absolute; border: 1px solid var(--line-strong); border-radius: 999px; }
.hero-orbit.one { width: 290px; height: 140px; transform: rotate(-12deg); }
.hero-orbit.two { width: 240px; height: 110px; transform: rotate(28deg); }
.hero-core { position: relative; z-index: 2; width: 96px; height: 96px; display: grid; place-items: center; border-radius: 50%; background: var(--surface-strong); border: 1px solid var(--accent-dark); box-shadow: 0 0 45px rgba(45, 212, 191, .12); }
.hero-core svg { width: 40px; height: 40px; color: var(--accent); }
.orbit-node { position: absolute; z-index: 3; min-width: 92px; padding: 8px 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--bg-raised); color: var(--text-secondary); font-size: 10px; text-align: center; }
.orbit-node.a { top: 8px; left: 20px; }
.orbit-node.b { top: 14px; right: 6px; }
.orbit-node.c { bottom: 6px; left: 34px; }
.orbit-node.d { right: 28px; bottom: 0; }

.kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
.kpi {
  min-height: 114px;
  padding: 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}
.kpi-label { color: var(--text-muted); font-size: 10px; line-height: 1.4; text-transform: uppercase; letter-spacing: .08em; }
.kpi-value { margin-top: 13px; font-size: 25px; font-weight: 760; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
.kpi-context { margin-top: 7px; color: var(--text-secondary); font-size: 10px; line-height: 1.4; }

.two-column { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .55fr); gap: 18px; }
.three-column { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.flow-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; }
.flow-step { position: relative; padding: 18px; min-height: 128px; border-right: 1px solid var(--line); }
.flow-step:last-child { border-right: 0; }
.flow-number { color: var(--accent); font-size: 10px; font-weight: 800; letter-spacing: .12em; }
.flow-step h3 { margin: 12px 0 8px; font-size: 13px; }
.flow-step p { margin: 0; color: var(--text-muted); font-size: 11px; line-height: 1.55; }

.scenario-list { display: grid; }
.scenario-row {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  min-height: 82px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--line);
  cursor: pointer;
  background: transparent;
}
.scenario-row:last-child { border-bottom: 0; }
.scenario-row:hover { background: var(--surface-hover); }
.scenario-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--bg-raised); border: 1px solid var(--line); color: var(--accent); }
.scenario-icon svg { width: 17px; height: 17px; }
.scenario-title { font-size: 13px; font-weight: 700; }
.sc