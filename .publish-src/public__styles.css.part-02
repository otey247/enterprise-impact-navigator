enario-description { margin-top: 4px; color: var(--text-muted); font-size: 11px; }
.scenario-category { color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }

.question-panel { padding: 18px; }
.question-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
.question-input {
  width: 100%;
  min-height: 46px;
  padding: 0 15px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--bg-raised);
  color: var(--text);
  outline: none;
}
.question-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(45, 212, 191, .1); }
.question-options { margin-top: 12px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.toggle { display: inline-flex; align-items: center; gap: 9px; color: var(--text-secondary); font-size: 11px; cursor: pointer; }
.toggle input { position: absolute; opacity: 0; pointer-events: none; }
.toggle-track { width: 34px; height: 19px; padding: 2px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--bg-raised); transition: .2s; }
.toggle-knob { width: 13px; height: 13px; display: block; border-radius: 50%; background: var(--text-muted); transition: .2s; }
.toggle input:checked + .toggle-track { background: var(--accent-dark); border-color: var(--accent); }
.toggle input:checked + .toggle-track .toggle-knob { transform: translateX(15px); background: var(--text); }
.execution-note { color: var(--text-muted); font-size: 10px; }

.answer-summary { padding: 20px; }
.answer-summary h2 { margin: 0 0 10px; font-size: 18px; letter-spacing: -.025em; }
.answer-summary p { margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
.answer-meta { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
.meta-chip { padding: 6px 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--text-muted); font-size: 10px; }
.meta-chip strong { color: var(--text-secondary); }

.graph-layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; min-height: 560px; }
.graph-stage { position: relative; min-width: 0; overflow: hidden; background: #0b0e12; }
.graph-toolbar { position: absolute; z-index: 5; top: 14px; left: 14px; display: flex; gap: 6px; }
.graph-toolbar button { width: 34px; height: 34px; padding: 0; background: rgba(17, 21, 26, .92); }
.graph-canvas { width: 100%; height: 560px; display: block; }
.graph-edge { stroke: #35404a; stroke-width: 1.4; fill: none; marker-end: url(#arrow); }
.graph-edge.focus { stroke: var(--accent); stroke-width: 2.1; }
.graph-edge-label { fill: #74808c; font-size: 8px; text-anchor: middle; }
.graph-node { cursor: pointer; }
.graph-node circle { fill: #151b21; stroke: #47525e; stroke-width: 1.5; }
.graph-node.focus circle { stroke: var(--accent); stroke-width: 2.2; }
.graph-node.selected circle { fill: #173d39; stroke: #5eead4; stroke-width: 2.6; }
.graph-node text.node-label { fill: #eef2f5; font-size: 9px; font-weight: 650; text-anchor: middle; pointer-events: none; }
.graph-node text.node-type { fill: #77838f; font-size: 7px; text-anchor: middle; text-transform: uppercase; pointer-events: none; }
.entity-inspector { border-left: 1px solid var(--line); background: var(--surface); }
.inspector-empty { min-height: 100%; padding: 26px; display: grid; place-content: center; text-align: center; color: var(--text-muted); font-size: 12px; line-height: 1.6; }
.inspector-content { padding: 20px; }
.inspector-type { color: var(--accent); font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
.inspector-content h3 { margin: 10px 0 6px; font-size: 18px; letter-spacing: -.025em; }
.inspector-subtitle { color: var(--text-secondary); font-size: 11px; }
.detail-list { margin: 20px 0 0; display: grid; gap: 12px; }
.detail-item { padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.detail-label { color: var(--text-muted); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.detail-value { margin-top: 5px; color: var(--text-secondary); font-size: 11px; line-height: 1.5; word-break: break-word; }

.evidence-list { display: grid; gap: 10px; }
.evidence-item { border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-raised); }
.evidence-trigger {
  width: 100%;
  padding: 13px 14px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}
.evidence-claim { font-size: 11px; line-height: 1.45; }
.confidence { color: var(--accent); font-size: 10px; font-variant-numeric: tabular-nums; }
.evidence-path { display: none; padding: 0 14px 14px; }
.evidence-item.open .evidence-path { display: block; }
.path-chain { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; }
.path-node { padding: 7px 9px; background: var(--surface); border: 1px solid var(--line); bord