condary); font-size: 10px; font-weight: 600; }
.quality-bar { height: 4px; margin-top: 14px; background: var(--bg); border-radius: 999px; overflow: hidden; }
.quality-bar span { display: block; height: 100%; background: var(--accent); }

.empty-state { min-height: 300px; padding: 32px; display: grid; place-content: center; justify-items: center; text-align: center; }
.empty-state svg { width: 36px; height: 36px; color: var(--accent); }
.empty-state h2 { margin: 16px 0 7px; font-size: 18px; }
.empty-state p { max-width: 480px; margin: 0; color: var(--text-muted); font-size: 12px; line-height: 1.6; }

.loading-overlay { position: fixed; z-index: 100; inset: 0; display: grid; place-items: center; background: rgba(8, 10, 13, .82); backdrop-filter: blur(6px); }
.loading-card { width: min(420px, calc(100vw - 40px)); padding: 24px; border: 1px solid var(--line-strong); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow); }
.loading-title { font-size: 14px; font-weight: 750; }
.loading-step { margin-top: 10px; color: var(--text-muted); font-size: 11px; }
.loading-bar { height: 3px; margin-top: 18px; background: var(--line); overflow: hidden; }
.loading-bar::after { content: ''; display: block; width: 36%; height: 100%; background: var(--accent); animation: loading 1.2s infinite ease-in-out; }
@keyframes loading { from { transform: translateX(-100%); } to { transform: translateX(380%); } }

.command-dialog { position: fixed; z-index: 90; inset: 0; display: grid; place-items: start center; padding-top: min(18vh, 150px); background: rgba(0,0,0,.72); backdrop-filter: blur(4px); }
.command-box { width: min(720px, calc(100vw - 32px)); border: 1px solid var(--line-strong); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
.command-input-wrap { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
.command-input-wrap svg { width: 20px; height: 20px; color: var(--text-muted); }
.command-input-wrap input { flex: 1; border: 0; outline: 0; background: transparent; color: var(--text); font-size: 15px; }
.command-scenarios { padding: 8px; }
.command-scenario { width: 100%; padding: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 0; border-radius: var(--radius-sm); background: transparent; cursor: pointer; text-align: left; }
.command-scenario:hover { background: var(--surface-hover); }
.command-scenario-title { font-size: 11px; font-weight: 650; }
.command-scenario-category { color: var(--text-muted); font-size: 9px; }

.toast-region { position: fixed; z-index: 110; right: 20px; bottom: 20px; display: grid; gap: 8px; }
.toast { width: min(360px, calc(100vw - 40px)); padding: 13px 15px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--surface-strong); box-shadow: var(--shadow); font-size: 11px; line-height: 1.45; animation: toast-in .18s ease-out; }
.toast strong { display: block; margin-bottom: 3px; color: var(--text); }
.toast span { color: var(--text-secondary); }
@keyframes toast-in { from { transform: translateY(8px); opacity: 0; } }

@media (max-width: 1200px) {
  .kpi-grid { grid-template-columns: repeat(3, 1fr); }
  .hero-panel { grid-template-columns: 1fr; }
  .hero-diagram { display: none; }
  .source-grid { grid-template-columns: repeat(2, 1fr); }
  .flow-list { grid-template-columns: repeat(3, 1fr); }
  .flow-step:nth-child(3) { border-right: 0; }
  .flow-step:nth-child(n+4) { border-top: 1px solid var(--line); }
}

@media (max-width: 900px) {
  :root { --sidebar-width: 76px; }
  .brand { padding: 0 20px; }
  .brand > div:last-child, .nav-label, .nav-count, .sidebar-footer { display: none; }
  .nav-button { justify-content: center; padding: 0; }
  .main-content { padding: 22px 18px 46px; }
  .topbar { padding: 0 18px; }
  .capability-status { display: none; }
  .two-column, .graph-layout { grid-template-columns: 1fr; }
  .entity-inspector { border-left: 0; border-top: 1px solid var(--line); min-height: 210px; }
  .graph-canvas { height: 480px; }
  .source-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  :root { --sidebar-width: 0px; --topbar-height: 74px; }
  .sidebar { display: none; }
  .workspace { margin-left: 0; }
  .topbar h1 { font-size: 20px; }
  .eyebrow, .button kbd { display: none; }
  .topbar-actions .button { padding: 0 10px; font-size: 0; }
  .topbar-actions .button svg { margin: 0; }
  .hero-panel { padding: 21px; }
  .hero-copy h2 { font-size: 30px; }
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .flow-list { grid-template-columns: 1fr; }
  .flow-step { border-right: 0; border-bottom: 1px solid var(--line); }
  .flow-step:last-child { border-bottom: 0; }
  .flow-step:nth-child(n+4) { border-top: 0; }
  .question-form { grid-template-columns: 1fr; }
  .question-options { align-items: start; flex-direction: column; }
  .action-item { grid-templat