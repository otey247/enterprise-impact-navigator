:root {
  color-scheme: dark;
  --bg: #080a0d;
  --bg-raised: #0d1014;
  --surface: #11151a;
  --surface-strong: #171c22;
  --surface-hover: #1b2128;
  --line: #2a3139;
  --line-strong: #3a444f;
  --text: #f4f7f9;
  --text-secondary: #a9b2bc;
  --text-muted: #707b86;
  --accent: #2dd4bf;
  --accent-strong: #14b8a6;
  --accent-dark: #0f766e;
  --danger: #fb7185;
  --warning: #fbbf24;
  --success: #34d399;
  --info: #60a5fa;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --sidebar-width: 250px;
  --topbar-height: 86px;
  --shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }
html { background: var(--bg); }
body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 75% -10%, rgba(45, 212, 191, 0.08), transparent 34%),
    var(--bg);
  color: var(--text);
}
button, input, textarea, select { font: inherit; }
button { color: inherit; }
a { color: inherit; }

.skip-link {
  position: fixed;
  z-index: 1000;
  top: 8px;
  left: 8px;
  padding: 10px 14px;
  background: var(--text);
  color: var(--bg);
  transform: translateY(-150%);
  border-radius: var(--radius-sm);
}
.skip-link:focus { transform: translateY(0); }

.app-shell { min-height: 100vh; }
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: var(--sidebar-width);
  display: flex;
  flex-direction: column;
  background: #0a0d10;
  border-right: 1px solid var(--line);
  z-index: 30;
}
.brand {
  min-height: var(--topbar-height);
  padding: 0 22px;
  display: flex;
  align-items: center;
  gap: 13px;
  border-bottom: 1px solid var(--line);
}
.brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3px;
  transform: rotate(45deg);
}
.brand-mark span { background: var(--accent); border-radius: 2px; }
.brand-mark span:nth-child(2), .brand-mark span:nth-child(3) { opacity: .55; }
.brand-name { font-size: 14px; font-weight: 750; letter-spacing: -0.01em; }
.brand-kicker { color: var(--text-muted); font-size: 10px; letter-spacing: .12em; margin-top: 3px; }

.primary-nav { padding: 20px 12px; display: grid; gap: 4px; }
.nav-button {
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  text-align: left;
}
.nav-button:hover { background: var(--surface); color: var(--text); }
.nav-button[aria-current="page"] {
  background: var(--surface-strong);
  border-color: var(--line-strong);
  color: var(--text);
}
.nav-button svg { width: 18px; height: 18px; }
.nav-label { flex: 1; font-size: 13px; font-weight: 650; }
.nav-count {
  color: var(--text-muted);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
}
.sidebar-footer {
  margin-top: auto;
  padding: 18px 22px 22px;
  border-top: 1px solid var(--line);
}
.environment-label { color: var(--text-muted); font-size: 9px; letter-spacing: .12em; }
.environment-value { margin-top: 8px; display: flex; align-items: center; gap: 8px; font-size: 12px; }
.status-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--success); box-shadow: 0 0 10px rgba(52, 211, 153, .55); }
.environment-meta { color: var(--text-muted); font-size: 11px; margin-top: 6px; }

.workspace { margin-left: var(--sidebar-width); min-height: 100vh; }
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: var(--topbar-height);
  padding: 0 28px 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: rgba(8, 10, 13, .9);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(16px);
}
.eyebrow { margin: 0 0 6px; color: var(--accent); font-size: 9px; font-weight: 750; letter-spacing: .15em; }
h1 { margin: 0; font-size: 24px; letter-spacing: -.035em; }
.topbar-actions, .capability-status { display: flex; align-items: center; gap: 10px; }
.capability-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--text-secondary);
  background: var(--bg-raised);
  font-size: 11px;
}
.capability-pill .status-dot { width: 6px; height: 6px; box-shadow: none; }
.capability-pill.off .status-dot { background: var(--text-muted); }

.main-content { padding: 28px 32px 56px; max-width: 1680px; margin: 0 auto; outline: none; }
.view-stack { display: grid; gap: 22px; }

.button {
  min-height: 38px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  transition: background .16s ease, border-color .16s ease, transform .16s ease;
}
.button:hover { transform: translateY(-1px);